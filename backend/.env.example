# Copy to backend/.env and fill in. Never commit the real .env file.

# development | test | production
APP_ENV=development
# Required in production: a random string of at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-env

DATABASE_URL=postgresql+psycopg://pipl:pipl@localhost:5432/pipl

# Sessions. Set COOKIE_SECURE=true when served over HTTPS (required in production).
SESSION_HOURS=12
COOKIE_SECURE=false
# Comma-separated list of allowed browser origins (only needed when the frontend runs on a different origin).
CORS_ORIGINS=http://localhost:5173

# File storage (private directory, never served directly)
# UPLOAD_DIR=/var/lib/pipl/uploads
MAX_UPLOAD_MB=25

# Optional AI analysis for status reports. Leave empty to use the deterministic template analysis.
# The key is only read by the backend and is never sent to the browser or written to logs.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=120

# Optional email delivery for notifications. Email is only attempted when SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Background scheduler for reminders and alerts
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
DEFAULT_TIMEZONE=Asia/Kolkata

# Rate limits (per IP per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600

# Sample data commands (seed-sample / reset-sample) are always refused when APP_ENV=production.
ALLOW_SAMPLE_DATA=true
LOG_LEVEL=INFO
